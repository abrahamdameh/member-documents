{
    "name": "abrahamdameh/member-documents",
    "description": "Versioned document templates, recorded member acceptance and PDF archives for WordPress membership sites.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Abraham Dameh"
        }
    ],
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "MemberDocuments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MemberDocuments\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "MemberDocuments\\Vendor\\",
            "classmap_prefix": "MemberDocuments_Vendor_",
            "constant_prefix": "MDOCS_VENDOR_",
            "packages": [
                "dompdf/dompdf"
            ],
            "exclude_from_prefix": {
                "packages": [
                    "dompdf/php-font-lib"
                ]
            },
            "delete_vendor_packages": true,
            "update_call_sites": [
                "src"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    }
}
